# ============================================================================
# Fem CRM — variables de entorno
#
# Copia este archivo a .env.local y rellena los valores.
# En Vercel las mismas claves van en Settings → Environment Variables.
# NUNCA subas .env.local a git: ya está en .gitignore.
# ============================================================================


# ── Base de datos · Supabase ────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL usa el "Transaction pooler" (puerto 6543); es la que usa la app.
# DIRECT_URL usa la "Direct connection" (puerto 5432); solo para migraciones.
DATABASE_URL="postgresql://postgres.XXXX:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
# Solo estas dos: el CRM no usa el cliente de navegador de Supabase, así que
# NEXT_PUBLIC_SUPABASE_URL y _ANON_KEY no hacen falta.
SUPABASE_URL="https://XXXX.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""          # secreta: solo servidor. Autentica el login.


# ── Sesión del CRM ──────────────────────────────────────────────────────────
# Cadena aleatoria larga. Genérala con:  openssl rand -base64 48
# Firma el token de sesión y los enlaces temporales de los adjuntos.
JWT_SECRET=""

# URL pública del CRM. Se usa para armar las URLs de webhook en Ajustes.
NEXT_PUBLIC_APP_URL="https://fem-crm.vercel.app"

# Protege /api/cron/*. Ponla también en Vercel para que solo el cron entre.
CRON_SECRET=""


# ── Meta · WhatsApp Cloud API, Instagram y Facebook ─────────────────────────
# developers.facebook.com → tu app → WhatsApp → API Setup
META_APP_SECRET=""                    # verifica la firma de cada webhook

# Token PERMANENTE de un usuario de sistema (Business Settings → System users).
# El token temporal de 24 h del panel no sirve en producción.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""           # ID del número emisor
WHATSAPP_BUSINESS_ACCOUNT_ID=""       # WABA ID: hace falta para las plantillas

# Cadena que tú inventas; se repite igual en el panel de webhooks de Meta.
META_WEBHOOK_VERIFY_TOKEN=""

# Solo si se atiende Instagram Direct: distingue lo de IG de lo de Messenger.
META_INSTAGRAM_ACCOUNT_ID=""


# ── Mastershop ──────────────────────────────────────────────────────────────
# Mastershop → Configuración → Integraciones / API
MASTERSHOP_API_KEY=""
MASTERSHOP_WEBHOOK_SECRET=""
MASTERSHOP_API_URL="https://prod.api.mastershop.com/api"


# ── Shopify ─────────────────────────────────────────────────────────────────
# Shopify admin → Settings → Apps and sales channels → Develop apps
# Scopes mínimos de lectura: read_orders, read_customers, read_checkouts,
# read_products, read_fulfillments.
SHOPIFY_SHOP_DOMAIN="fem-co.myshopify.com"
SHOPIFY_ACCESS_TOKEN=""               # empieza por shpat_
SHOPIFY_WEBHOOK_SECRET=""             # clave de firma de los webhooks
